# Maintainer: Llamancer contributors
pkgname=llamancer-git
pkgver=0.1.0beta.3.r0
pkgrel=1
pkgdesc='Terminal-native local llama.cpp inference and coding agent control center'
arch=('x86_64' 'aarch64')
url='https://github.com/0xlillith/llamancer'
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('git' 'rust' 'python')
optdepends=('btop: resource monitoring' 'xdg-utils: open server Web UI' 'kitty: agent tabs and windows' 'fontconfig: optional Nerd Font detection' 'ttf-jetbrains-mono-nerd: optional terminal icons')
provides=('llamancer')
conflicts=('llamancer')
# ring's C/assembly objects must not contain GCC LTO bitcode when Rust links with LLD.
options=('!lto' 'docs')
source=('llamancer::git+https://github.com/0xlillith/llamancer.git')
sha256sums=('SKIP')

pkgver() {
  cd llamancer
  local version
  version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | head -1)
  version=${version//-/}
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd llamancer
  cargo build --locked --release
}

check() {
  cd llamancer
  cargo test --locked --all-targets
}

package() {
  cd llamancer
  install -Dm755 target/release/llamancer "$pkgdir/usr/bin/llamancer"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  python scripts/stage-documentation.py "$pkgdir/usr/share/doc/$pkgname"
  python scripts/collect-notices.py "$pkgdir/usr/share/licenses/$pkgname/third-party-notices"
  install -Dm644 packaging/systemd/llamancer.service "$pkgdir/usr/lib/systemd/user/llamancer.service"
  sed -i "s|%h/.cargo/bin/llamancer|/usr/bin/llamancer|" "$pkgdir/usr/lib/systemd/user/llamancer.service"
  install -Dm644 assets/hex.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/llamancer.svg"
}
